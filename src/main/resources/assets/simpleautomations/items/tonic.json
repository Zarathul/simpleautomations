				},
				"model": {
					"type": "minecraft:model",
					"model": "simpleautomations:item/silence_tonic"
				}
			}
		],
		"fallback": {
			"type": "minecraft:model",
			"model": "simpleautomations:item/antidote"
		}
	}
}